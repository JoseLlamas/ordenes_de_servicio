		"lodash": "^4.17.21",
		"mysql2": "^3.16.0",
		"nanoid": "^5.1.6",
		"sharp": "^0.34.5",
		"signature_pad": "^5.1.3",
		"temporal-polyfill": "^0.3.0"
	},

	"volta": {
		"node": "24.12.0",
		"pnpm": "11.9.0"
	}
